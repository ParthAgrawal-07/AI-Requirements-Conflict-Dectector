# Copy to .env and fill in real values: `cp .env.example .env`
# .env is gitignored — never commit real secrets (NFR-12).

# ── Runtime ───────────────────────────────────────────────
# development | test | staging | production
# staging/production additionally require a strong JWT_SECRET and an explicit CORS list
# (see app/core/config.py) — the app refuses to start otherwise.
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────
# POSTGRES_* configure the `db` container itself (docker-compose.yml).
# DATABASE_URL is what the backend actually connects with — host "db" is that same
# container's name on the Compose network. Running the backend outside Docker? Use
# "localhost" instead.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=requirements_conflict_detector
DATABASE_URL=postgresql://postgres:postgres@db:5432/requirements_conflict_detector

# ── Redis / Celery ────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Auth (FR-37) ──────────────────────────────────────────
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The "dev-only-" prefix below is accepted in development/test but rejected in
# staging/production — see app/core/config.py.
JWT_SECRET=dev-only-insecure-secret-change-before-any-shared-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=60
# FR-43: false = only platform admins create workspaces; true = any signed-in user may.
# (Sign-up itself always needs a join code.)
ALLOW_USER_WORKSPACE_CREATION=false
# NFR-35: join-code attempts per minute, per IP and per e-mail, on POST /auth/signup.
SIGNUP_ATTEMPTS_PER_MINUTE=5
# How many reverse proxies sit in front of the API (Render = 1, local = 0). Rate limits key on the
# real client address: with 0 the socket peer is used and X-Forwarded-For is ignored (forgeable);
# with N the N-th entry from the right is trusted. Wrong value behind a proxy = one shared limit.
TRUSTED_PROXY_HOPS=0

# ── HTTP / CORS ───────────────────────────────────────────
# Comma-separated. Must be explicit origins in staging/production — "*" is rejected.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Uploads (FR-01, FR-02) ────────────────────────────────
MAX_UPLOAD_SIZE_MB=25
UPLOAD_DIR=/data/uploads

# ── Embedding / Similarity (FR-10, US-06) ─────────────────
# Workspace-level overrides of this default are stored in the database, not here.
SIMILARITY_THRESHOLD_DEFAULT=0.75

# ── LLM (classification + clarification generation) ──────
LLM_PROVIDER=anthropic
# Leave empty to run without an LLM: the brief is drafted by rules and classification is refused.
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ── Frontend ──────────────────────────────────────────────
# Read by Vite at build/dev time (see frontend/src/lib/api-client.ts).
VITE_API_BASE_URL=http://localhost:8000

# ── Optional: host port overrides ─────────────────────────
# Uncomment if the defaults below already collide with something else on your machine.
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# BACKEND_PORT=8000
# FRONTEND_PORT=5173
