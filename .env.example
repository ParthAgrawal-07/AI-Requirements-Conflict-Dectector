# ── Database ──────────────────────────────────────────────
# Used directly by docker-compose.yml for the Postgres container,
# and combined into DATABASE_URL below for the backend to connect.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=requirements_conflict_detector

DATABASE_URL=postgresql://postgres:postgres@db:5432/requirements_conflict_detector

# ── Redis / Celery ────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── LLM ───────────────────────────────────────────────────
LLM_PROVIDER=anthropic
LLM_API_KEY=your_api_key_here

# ── Auth ──────────────────────────────────────────────────
JWT_SECRET=change_me

# ── Embedding / Similarity ────────────────────────────────
SIMILARITY_THRESHOLD=0.75

# ── Frontend ──────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
